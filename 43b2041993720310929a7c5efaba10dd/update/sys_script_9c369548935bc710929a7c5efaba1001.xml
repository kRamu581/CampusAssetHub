        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Get the expected and actual dates
    var expected = new GlideDateTime(current.u_expected_return_date);
    var actual = new GlideDateTime(current.u_actual_return_date);

    // If actual return date is AFTER expected return date
    if (actual.compareTo(expected) == 1) {
        
        // Find the difference in days
        var diff = GlideDateTime.subtract(expected, actual);
        var daysLate = diff.getRoundedDayPart();
        
        // Example: $5 penalty per day late
        var penaltyAmount = daysLate * 5; 
        
        // Alert the staff member processing the return!
        gs.addErrorMessage("LATE RETURN: Student is " + daysLate + " days late. A penalty of $" + penaltyAmount + " must be paid.");
        
        // Optional: If you want to save this to the database, you can create a 
        // u_penalty_fee currency field and set it here!
        // current.u_penalty_fee = penaltyAmount;
    }

})(current, previous);]]></script>
