        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    if (!current.textbook.nil()) {

        var bookGR = new GlideRecord('u_textbook'); // replace with YOUR real table name
        if (bookGR.get(current.textbook)) {

            var wasAllocated = previous && previous.allocation_status == 'Allocated';
            var isNowAllocated = current.allocation_status == 'Allocated';
            var isNowReturned = current.allocation_status == 'Returned';

            // New allocation just created or changed TO allocated
            if (isNowAllocated && (!previous || previous.allocation_status != 'Allocated')) {
                bookGR.available_copies = parseInt(bookGR.available_copies) - 1;
            }

            // Changed FROM allocated TO returned
            if (isNowReturned && wasAllocated) {
                bookGR.available_copies = parseInt(bookGR.available_copies) + 1;
            }

            bookGR.update();
        }
    }

})(current, previous);]]></script>
